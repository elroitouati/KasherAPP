{
  "expo": {
    "name": "בודק כשרות",
    "slug": "kasher-check",
    "scheme": "kashercheck",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#041A4E",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.elroitouati.kashercheck",
      "infoPlist": {
        "ExpoLocalization_forcesRTL": true
      }
    },
    "android": {
      "package": "com.elroitouati.kashercheck",
      "adaptiveIcon": {
        "backgroundColor": "#042B73",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.CAMERA"
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-localization",
        {
          "forcesRTL": true
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "המצלמה משמשת לקריאת רשימת הרכיבים על אריזות מזון.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "minSdkVersion": 26
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#041A4E"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8b8f806d-10ea-4d11-806b-90fecc7acc3d"
      }
    },
    "owner": "elroi_touati",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/8b8f806d-10ea-4d11-806b-90fecc7acc3d",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
